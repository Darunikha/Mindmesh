# https://editorconfig.org: most editors pick this up automatically (VS Code needs the "EditorConfig" extension).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces mean a line break in Markdown, so don't strip them.
[*.md]
trim_trailing_whitespace = false

# Generated by npm; never hand-edited.
[package-lock.json]
indent_size = 2
insert_final_newline = unset
trim_trailing_whitespace = unset

[Dockerfile]
indent_size = 4
