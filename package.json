{
  "name": "mindmesh",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered personal knowledge and learning workspace",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "test": "npm test -w server && npm test -w client",
    "lint": "npm run lint -w client",
    "check:ui": "node scripts/ui-check.mjs",
    "start": "npm run build && npm run start:prod -w server"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.0"
  }
}
