# ─────────────────────────────────────────────────────────────
#  Mindmesh server configuration
#  Copy to server/.env and fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173
# Set to true when running behind a reverse proxy / load balancer (for correct client IPs)
TRUST_PROXY=false

# ── Database (Phase 1) ───────────────────────────────────────
# MongoDB Atlas is recommended: Phase 3 uses Atlas Vector Search for RAG.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mindmesh?retryWrites=true&w=majority
MONGODB_URI=
# Dev-only: start a throwaway in-memory MongoDB when MONGODB_URI is empty. Data is lost on restart.
USE_IN_MEMORY_DB=false

# ── Authentication (Phase 1) ─────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12

# ── Knowledge library (Phase 2) ──────────────────────────────
# Where uploaded files are stored (relative to server/). Each user gets a subfolder.
UPLOAD_DIR=./uploads
# Maximum upload size in megabytes
MAX_UPLOAD_MB=25
# How many documents/links are processed in parallel in the background
PROCESSING_CONCURRENCY=2
# Website fetching limits for saved links
LINK_FETCH_TIMEOUT_MS=10000
LINK_MAX_BYTES=3000000
# Dev/test only: allow fetching localhost and private-network URLs (blocked by default for SSRF safety)
ALLOW_PRIVATE_LINK_FETCH=false

# ── AI assistant (Phase 3) ───────────────────────────────────
# Chat provider. Built in: anthropic. New providers implement src/ai/chat/ and register a name.
AI_PROVIDER=anthropic
# Get a key at https://console.anthropic.com/ — without one, the assistant shows a setup message.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Optional cheaper model for titles, follow-up suggestions and conversation summaries (defaults to AI_MODEL)
# AI_UTILITY_MODEL=claude-haiku-5-5
# Reasoning effort: low | medium | high | xhigh | max
AI_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=16000
# Anthropic server-side refusal fallbacks (re-runs a declined request on a fallback model)
AI_REFUSAL_FALLBACKS=true

# ── Embeddings + semantic search (Phase 3) ───────────────────
# voyage (recommended, https://dash.voyageai.com/) | openai | none
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
# OPENAI_API_KEY=
# Defaults: voyage-3.5 (1024 dims) / text-embedding-3-small (1536 dims)
# EMBEDDING_MODEL=voyage-3.5
# EMBEDDING_DIMENSIONS=1024

# auto: use MongoDB Atlas Vector Search when the index exists, otherwise compute similarity in-process
# atlas | local | auto
VECTOR_SEARCH=auto
# Create it with: npm run vector-index -w server
VECTOR_INDEX_NAME=chunk_embedding_index
# How many passages are given to the model, and the minimum similarity for a passage to count
RAG_TOP_K=8
RAG_MIN_SCORE=0.3
