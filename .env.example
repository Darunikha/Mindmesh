# Settings for docker-compose.yml. Copy this file to ".env" in the same folder and fill it in.
# (This is separate from server/.env, which is used when you run Mindmesh without Docker.)
# Never commit your real .env file; it is already listed in .gitignore.

# ── Required: two different random secrets, at least 32 characters each ──────────────
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Optional: AI features (the app works without these; the assistant then shows a setup message) ──
# Anthropic key for the assistant: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Embedding key for "My Knowledge" semantic search: https://dash.voyageai.com/ (or use OPENAI_API_KEY with EMBEDDING_PROVIDER=openai)
VOYAGE_API_KEY=
# EMBEDDING_PROVIDER=voyage
# OPENAI_API_KEY=
# AI_MODEL=claude-opus-5-5

# ── Optional: email for "Forgot password?" (any SMTP service; see "Email setup" in the README) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# MAIL_FROM=Mindmesh <you@gmail.com>
# Address used in emailed links, if it differs from CLIENT_ORIGIN:
# APP_URL=https://notes.example.com

# ── Optional: where it is served ───────────────────────────────────────────────────────
# Port on your computer (the container always listens on 4000 inside).
# APP_PORT=4000
# If you put Mindmesh behind a domain and an HTTPS reverse proxy, set both of these:
# CLIENT_ORIGIN=https://notes.example.com
# TRUST_PROXY=true
